{
    "name": "chef-corner-app",
    "main": "expo-router/entry",
    "version": "1.0.0",
    "scripts": {
        "start": "TAILWIND_WATCH=true expo start",
        "start:clear": "TAILWIND_WATCH=true expo start --clear",
        "reset-project": "node ./scripts/reset-project.js",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "web": "expo start --web",
        "test": "jest --watchAll",
        "lint": "eslint . --fix",
        "type-check": "tsc --pretty --skipLibCheck",
        "format": "prettier --check ./app",
        "prepare": "husky"
    },
    "jest": {
        "preset": "jest-expo"
    },
    "dependencies": {
        "@expo/vector-icons": "^14.0.2",
        "@hookform/resolvers": "^3.9.0",
        "@react-native-async-storage/async-storage": "1.23.1",
        "@react-navigation/native": "^7.0.0",
        "axios": "^1.7.7",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "expo": "^52.0.23",
        "expo-build-properties": "~0.13.1",
        "expo-constants": "~17.0.3",
        "expo-font": "~13.0.2",
        "expo-linking": "~7.0.3",
        "expo-router": "~4.0.15",
        "expo-secure-store": "~14.0.0",
        "expo-splash-screen": "~0.29.18",
        "expo-status-bar": "~2.0.0",
        "expo-system-ui": "~4.0.6",
        "expo-web-browser": "~14.0.1",
        "lucide-react-native": "^0.456.0",
        "nativewind": "^4.1.23",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-hook-form": "^7.53.1",
        "react-native": "0.76.5",
        "react-native-gesture-handler": "~2.20.2",
        "react-native-network-logger": "^1.17.0",
        "react-native-reanimated": "~3.16.1",
        "react-native-safe-area-context": "4.12.0",
        "react-native-screens": "~4.4.0",
        "react-native-svg": "15.8.0",
        "react-native-web": "~0.19.10",
        "tailwind-merge": "^2.5.4",
        "tailwindcss": "^3.4.13",
        "yup": "^1.4.0"
    },
    "devDependencies": {
        "@babel/core": "^7.20.0",
        "@commitlint/cli": "^19.5.0",
        "@commitlint/config-conventional": "^19.5.0",
        "@eslint/js": "^9.12.0",
        "@types/jest": "^29.5.12",
        "@types/react": "~18.3.12",
        "@types/react-test-renderer": "^18.0.7",
        "eslint": "^9.12.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "eslint-plugin-react": "^7.37.1",
        "globals": "^15.10.0",
        "husky": "^9.1.6",
        "jest": "^29.2.1",
        "jest-expo": "~52.0.2",
        "lint-staged": "^15.2.10",
        "prettier": "3.3.3",
        "react-test-renderer": "18.2.0",
        "typescript": "~5.3.3",
        "typescript-eslint": "^8.8.0"
    },
    "lint-staged": {
        "*.{tsx,ts,js}": [
            "prettier --write"
        ],
        "**/*.{ts,tsx}": [
            "eslint --fix"
        ]
    },
    "private": true
}
